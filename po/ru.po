#| msgid "Language name:"
msgid "Enter a language name."
msgstr "Введите название языка."

#: virtaal/views/widgets/langadddialog.py
msgid "Language code must be an ASCII string."
msgstr "Код языка должен быть строкой ASCII."

#: virtaal/views/widgets/langadddialog.py
msgid "Language code must be at least 2 characters long."
msgstr "Код языка должен быть длиной как минимум 2 символа."

#: virtaal/views/widgets/langadddialog.py
msgid "Language code must not contain spaces."
msgstr "Код языка не должен содержать пробелы."


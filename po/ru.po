msgstr "Показать окно горячих клавиш"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Navigation"
msgstr "Навигация"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to next translation"
msgstr "Перейти к следующему переводу"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to previous unit"
msgstr "Перейти к предыдущему модулю"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to next unit"
msgstr "Перейти к следующему модулю"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move 10 units up"
msgstr "Перейти на 10 модулей вверх"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move 10 units down"
msgstr "Перейти на 10 модулей вниз"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to first unit"
msgstr "Перейти к первому модулю"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to last unit"
msgstr "Перейти к последнему модулю"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to next search match"
msgstr "Перейти к следующему совпадению"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to previous search match"
msgstr "Перейти к предыдущему совпадению"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Units"
msgstr "Модули"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Select previous placeable"
msgstr "Выбрать предыдущий спецобъект"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Select next placeable"
msgstr "Выбрать следующий спецобъект"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Insert the selected placeable"
msgstr "Вставить выбранный спецобъект"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Replace the translation with the source"
msgstr "Заменить перевод исходником"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Copy the source, if nothing is selected"
msgstr "Скопировать исходник если ничего не выбрано"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Enter a new line"
msgstr "Ввести новую строку"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Undo the last change"
msgstr "Отменить последнее изменение"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Redo the last undone change"
msgstr "Повторить последнее отмененное изменение"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Use the first translation suggestion"
msgstr "Использовать первое предложение перевода"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Show/Hide checks"
msgstr "Показать/скрыть проверки"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Show translation suggestions for this unit"
msgstr "Показать предложения перевода для этого модуля"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Turn translation suggestions on or off"
msgstr "Выключить предложения перевода"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Hide translation suggestions, if shown"
msgstr "Спрятать предложения перевода, если они отображаются"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Add a term to the local terminology file"
msgstr "Добавить термин в локальный файл терминологии"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Moving focus"
msgstr "Переместить фокус"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to the next target field"
msgstr "Переместить на следующее поле цели"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Move to the previous target field"
msgstr "Переместить на предыдущее поле цели"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Jump to the language-pair selector"
msgstr "Перейти к выбору языковой пары"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Jump to the \"Navigation:\" mode selector"
msgstr "Перейти к выбору режима «Навигация:»"

#: virtaal/views/widgets/shortcutswindow.py
msgid "Close the search bar and return to normal editing"
msgstr "Закрыть поисковую строку и вернуться к обычному редактированию"

